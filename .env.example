# ============================================
# CONFIGURACIÓN DE EJEMPLO - ECOMMERCE
# ============================================
# 
# Copiar este archivo a .env y completar con
# tus valores reales. NUNCA comitear .env
# con credenciales reales a GitHub.
#
# ============================================

# ============================================
# CONFIGURACIÓN FLASK
# ============================================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambiar_por_clave_segura_y_aleatoria_123456789

# ============================================
# BASE DE DATOS
# ============================================
# Opción 1: SQLite (desarrollo - default)
DATABASE_URL=sqlite:///ecommerce.db

# Opción 2: MySQL (producción)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/ecommerce_db
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# ============================================
# PAYPAL
# ============================================
# Modo: 'sandbox' para testing, 'live' para producción
PAYPAL_MODE=sandbox

# Obtener de: https://developer.paypal.com/dashboard/apps/sandbox
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_SECRET=tu_paypal_secret_aqui

# ============================================
# CORREO ELECTRÓNICO
# ============================================
# Gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# Obtener contraseña de app en:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_contraseña_app_google

# Configuración de remitente
MAIL_DEFAULT_SENDER=noreply@ecommerce.com
SUPPORT_EMAIL=soporte@ecommerce.com

# Clientes SMTP alternativos:
# 
# Outlook:
# MAIL_SERVER=smtp.outlook.com
# MAIL_PORT=587
# 
# Zoho Mail:
# MAIL_SERVER=smtp.zoho.com
# MAIL_PORT=587
#
# Servidor personalizado:
# MAIL_SERVER=mail.tudominio.com
# MAIL_PORT=587 o 25

# ============================================
# AUTENTICACIÓN JWT
# ============================================
JWT_SECRET_KEY=tu_jwt_secret_super_seguro_cambiar_9876543210
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# API ZONAS DE ENVÍO
# ============================================
# Registrarse en: https://www.zonas.com/api
API_ZONAS_USER=tu_usuario_api_zonas
API_ZONAS_PASSWORD=tu_contraseña_api_zonas

# Modo: 'sandbox' para testing, 'production' para producción
API_ZONAS_MODE=sandbox

# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================
# CSRF Protection
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=None

# Cookies seguras (cambiar a True en producción con HTTPS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
# Número de items por página en catálogo
ITEMS_PER_PAGE=12

# Tamaño máximo de archivo (16MB)
MAX_CONTENT_LENGTH=16777216

# Carpeta para uploads
UPLOAD_FOLDER=uploads/

# Extensiones permitidas para archivos
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# ============================================
# CONFIGURACIÓN DE ADMIN
# ============================================
# Habilitar panel administrativo
ADMIN_PANEL_ENABLED=True

# Requerir cambio de contraseña en primer login del admin
ADMIN_PASSWORD_RESET_REQUIRED=True

# ============================================
# CARACTERÍSTICAS
# ============================================
# Habilitar wishlist (lista de deseos)
ENABLE_WISHLIST=True

# Habilitar sistema de reseñas y calificaciones
ENABLE_REVIEWS=True

# Habilitar cupones y códigos de descuento
ENABLE_COUPONS=True

# Habilitar programa de referencia
ENABLE_REFERRAL=False

# ============================================
# LOGGING Y DEBUG
# ============================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Archivo para logs
LOG_FILE=app.log

# ============================================
# PRODUCCIÓN (Descomentar cuando deploys)
# ============================================
# FLASK_ENV=production
# DEBUG=False
# SESSION_COOKIE_SECURE=True
# PREFERRED_URL_SCHEME=https
# SQLALCHEMY_ECHO=False

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA comitear este archivo con datos reales
# 2. Usar valores diferentes para dev y producción
# 3. Cambiar SECRET_KEY en producción (comando):
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 4. Para PayPal testing, usar:
#    Email: sb-test@personal.example.com
#    (cualquier contraseña)
#
# 5. Gmail requiere "contraseña de app" específica
#    NO usar la contraseña regular de Gmail
#
# 6. API Zonas ofrece sandbox para testing
#    Cambiar a 'production' solo cuando esté verificado
#
# ==============================================
