* text=auto

# Source code
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf

# Binary files
*.zip binary
*.tar binary
*.gz binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary

# Large files (consider using Git LFS)
*.xml diff=lfs merge=lfs -text
api_zonas/data/CPdescarga.xml diff=lfs merge=lfs -text
